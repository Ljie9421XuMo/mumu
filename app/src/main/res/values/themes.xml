<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      原来是 Theme.AppCompat.DayNight：系统深色模式下文字会被换成白色，
      而 windowBackground 又写死成 #FFFFFF，结果白字白底，
      除 Button 外所有 TextView / EditText 全部隐形。
      改成 Light 系，固定浅色界面 + 深色文字，不再跟系统日夜切换。
    -->
    <style name="Theme.MuMu" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">#FFFFFFFF</item>
        <item name="android:textColorPrimary">#FF1A1A1A</item>
        <item name="android:textColorSecondary">#FF666666</item>
        <item name="android:textColor">#FF1A1A1A</item>
        <item name="android:textColorHint">#FF999999</item>
    </style>
</resources>
